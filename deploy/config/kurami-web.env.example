# Copy to the private secrets directory; missing team/audience denies access.
KURAMI_WEB_ACCESS_TEAM=
KURAMI_WEB_ACCESS_AUDIENCE=
# Optional extra identity restriction; otherwise the owner-only Access policy applies.
KURAMI_WEB_OWNER_EMAIL=
# Optional, separately scoped Docs reader application audience.
KURAMI_WEB_DOCS_AUDIENCE=
